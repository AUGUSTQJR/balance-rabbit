<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BalanceRabbit</AssemblyName>
    <RootNamespace>BalanceRabbit</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <Version>1.3.0</Version>
    <FileVersion>1.3.0.0</FileVersion>
    <Product>余额兔</Product>
    <AssemblyTitle>余额兔 · Windows 桌面余额宠物</AssemblyTitle>
    <Company>rabbitj.top</Company>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="icon.ico" LogicalName="BalanceRabbit.icon.ico" />
    <!-- 兔子形象：与 macOS 版同一份静态图片（build.sh 会从 pet/Assets 同步） -->
    <EmbeddedResource Include="Assets/pet_sky.png" LogicalName="BalanceRabbit.pet_sky.png" />
    <EmbeddedResource Include="Assets/pet_sky_low.png" LogicalName="BalanceRabbit.pet_sky_low.png" />
  </ItemGroup>

</Project>
